# Used only by scripts/create-admin.mjs and scripts/verify-deploy.mjs.
# Never expose these in the app.
# Local values come from `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321

# Hosted: Project Settings → API → Secret keys (sb_secret_...)
# Local: the service_role key from `supabase status`.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Optional: publishable key, lets verify-deploy.mjs run the RLS smoke test.
SUPABASE_ANON_KEY=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_NAME=Super Admin
USERNAME_DOMAIN=need-help.local
