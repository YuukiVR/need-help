# Frontend env — copy to .env.local
# Local values come from `supabase status` (API URL + anon key).
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Hosted: Project Settings → API → Publishable key (sb_publishable_...)
# Local: the anon key from `supabase status`. Safe to ship in the browser.
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Login maps "admin" -> "admin@need-help.local".
# Keep this in sync with USERNAME_DOMAIN in .env.admin.
VITE_USERNAME_DOMAIN=need-help.local

# Optional: browse the admin console with sample data, no database needed.
# Only works with `npm run dev` (ignored in production builds).
# Sign in with admin / admin.
# VITE_DEMO_MODE=true
